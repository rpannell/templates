<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>CodingTemplates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Coding Templates</Title>
    <Authors>Rodney Pannell</Authors>
    <Description>dotnet new templates: iDesign Web API, Dapr Functions-style worker (event, file), Rebus message worker (event, command), Dapr scheduler (cron), Liquibase database.</Description>
    <PackageTags>dotnet-new;templates;idesign;webapi;dapr;rebus;worker;liquibase</PackageTags>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Include dotfiles such as .dockerignore and .claude/ in the templates. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- Expected for template-only packages: NU5128 (no lib/ folder), NU5110/NU5111 (scripts in content). -->
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\_moved\**;templates\**\obj\**;templates\**\drop\processing\**;templates\**\drop\processed\**;templates\**\drop\failed\**;templates\**\.vs\**;templates\**\*.user" />
  </ItemGroup>

</Project>
