  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            ".vs/**",
            "**/*.user",
            ".template.config/**/*",
            "**/*.filelist",
            "**/*.lock.json"
          ]
        }
      ]
    }
  ]
}
