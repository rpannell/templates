{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=product;Username=product;Password=product"
  },
  "Pricing": {
    "DiscountThreshold": 500.0,
    "DiscountPercent": 5.0
  },
  "ExternalApis": {
    "Inventory": "https+http://inventory"
  },
  "Telemetry": {
    "PrometheusEndpoint": {
      "Enabled": true
    }
  }
}
