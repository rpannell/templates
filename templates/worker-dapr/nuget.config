<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, so machine-level feeds can't add NU1507 (multiple sources with central package management) warnings. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
