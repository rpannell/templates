{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Company.Product.Worker.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Company.Product.Worker.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "deps: up",
      "detail": "RabbitMQ (:15672), telemetry dashboard (:18888) and a Dapr sidecar for the worker on :5100",
      "type": "shell",
      "command": "docker compose --profile debug up -d --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "deps: down",
      "detail": "Stop every container of this project",
      "type": "shell",
      "command": "docker compose --profile debug --profile container down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "deps up + build",
      "dependsOrder": "sequence",
      "dependsOn": ["deps: up", "build"],
      "problemMatcher": []
    },
    {
      "label": "compose: up (all in containers)",
      "detail": "Worker image + sidecar + RabbitMQ + dashboard. Worker on :8080, sidecar on :3500",
      "type": "shell",
      "command": "docker compose --profile container up --build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "docker: build + test",
      "detail": "Same build CI runs: compile, all tests, runtime image",
      "type": "shell",
      "command": "docker build -t company-product-worker .",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "file: drop sample CSV",
      "detail": "Copy samples/orders.csv into drop/incoming/ to trigger the drop-folder function",
      "type": "shell",
      "command": "cp samples/orders.csv \"drop/incoming/orders-$(date +%Y%m%d%H%M%S).csv\"",
      "windows": {
        "command": "Copy-Item samples/orders.csv \"drop/incoming/orders-$(Get-Date -Format yyyyMMddHHmmss).csv\""
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "file: drop invalid CSV",
      "detail": "Copy samples/orders-invalid.csv into drop/incoming/: it ends up in drop/failed/ with an .error.txt",
      "type": "shell",
      "command": "cp samples/orders-invalid.csv \"drop/incoming/invalid-$(date +%Y%m%d%H%M%S).csv\"",
      "windows": {
        "command": "Copy-Item samples/orders-invalid.csv \"drop/incoming/invalid-$(Get-Date -Format yyyyMMddHHmmss).csv\""
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
