<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Master changelog. Releases are applied in the order listed; never reorder or remove an include.
        Each release ends with a tagDatabase changeset, which is the target for "down" deployments:
            liquibase rollback --tag=<previous release>
    -->
    <include file="releases/baseline.xml" relativeToChangelogFile="true"/>
    <include file="releases/1.0.0/changelog.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
