<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0002-create-order-lines" author="product">
        <comment>Lines of an order. Deleted with their order.</comment>
        <createTable tableName="order_lines">
            <column name="order_id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_order_lines" nullable="false"/>
            </column>
            <column name="line_number" type="int">
                <constraints primaryKey="true" primaryKeyName="pk_order_lines" nullable="false"/>
            </column>
            <column name="sku" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="decimal(18, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="line_total" type="decimal(18, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            constraintName="fk_order_lines_orders"
            baseTableName="order_lines" baseColumnNames="order_id"
            referencedTableName="orders" referencedColumnNames="id"
            onDelete="CASCADE"/>
        <rollback>
            <dropTable tableName="order_lines"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
