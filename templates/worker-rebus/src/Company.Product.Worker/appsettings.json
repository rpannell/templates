{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Rebus": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ExternalApis": {
    "Orders": "https+http://orders-api"
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "InputQueue": "worker",
    "ErrorQueue": "error",
    "NumberOfWorkers": 1,
    "MaxParallelism": 8,
    "MaxDeliveryAttempts": 5,
    "WorkerShutdownTimeout": "00:00:30"
  },
  "Telemetry": {
    "PrometheusEndpoint": {
      "Enabled": true
    }
  }
}
